datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  TEACHER
  DEAN
  PRESIDENT
}

model Faculty {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  departments Department[]
  projects    Project[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("faculties")
}

model Department {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  facultyId Int?      @map("faculty_id")
  faculty   Faculty?  @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  users     User[]
  projects  Project[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("departments")
}

model User {
  id           Int           @id @default(autoincrement())
  username     String        @unique
  password     String
  name         String
  role         Role
  departmentId Int?          @map("department_id")
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdProjects Project[]  @relation("ProjectCreator")
  assignedProjects ProjectUser[]
  issueReports IssueReport[]
  avatar       String?       @db.LongText @map("avatar")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("users")
}

model FiscalYear {
  id        Int       @id @default(autoincrement())
  year      Int       @unique
  active    Boolean   @default(false)
  projects  Project[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("fiscal_years")
}

model BudgetSource {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  projects  Project[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("budget_sources")
}

model LocalIssue {
  id         Int        @id @default(autoincrement())
  name       String
  code       String     @unique
  strategies Strategy[]
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@map("local_development_issues")
}

model Strategy {
  id            Int           @id @default(autoincrement())
  name          String
  code          String        @unique
  localIssueId  Int?          @map("local_issue_id")
  localIssue    LocalIssue?   @relation(fields: [localIssueId], references: [id], onDelete: SetNull)
  subStrategies SubStrategy[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("strategies")
}

model SubStrategy {
  id         Int         @id @default(autoincrement())
  name       String
  code       String      @unique
  strategyId Int         @map("strategy_id")
  strategy   Strategy    @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  indicators Indicator[]
  projects   Project[]
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@map("sub_strategies")
}

model Indicator {
  id             Int         @id @default(autoincrement())
  name           String
  code           String      @unique
  subStrategyId  Int         @map("sub_strategy_id")
  subStrategy    SubStrategy @relation(fields: [subStrategyId], references: [id], onDelete: Cascade)
  projects       Project[]
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@map("indicators")
}

model Project {
  id             Int           @id @default(autoincrement())
  name           String
  description    String?       @db.Text
  fiscalYearId   Int           @map("fiscal_year_id")
  fiscalYear     FiscalYear    @relation(fields: [fiscalYearId], references: [id])
  budgetSourceId Int           @map("budget_source_id")
  budgetSource   BudgetSource  @relation(fields: [budgetSourceId], references: [id])
  subStrategyId  Int           @map("sub_strategy_id")
  subStrategy    SubStrategy   @relation(fields: [subStrategyId], references: [id])
  indicatorId    Int?          @map("indicator_id")
  indicator      Indicator?    @relation(fields: [indicatorId], references: [id], onDelete: SetNull)
  totalBudget    Decimal       @db.Decimal(12, 2) @map("total_budget")
  targetCount    Int           @map("target_count")
  unit           String
  startDate      DateTime      @map("start_date")
  endDate        DateTime      @map("end_date")
  completedCount Int           @default(0) @map("completed_count")
  remainingCount Int           @default(0) @map("remaining_count")
  progress       Float         @default(0.0)
  creatorId      Int           @map("creator_id")
  creator        User          @relation("ProjectCreator", fields: [creatorId], references: [id])
  departmentId   Int?          @map("department_id")
  department     Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  facultyId      Int?          @map("faculty_id")
  faculty        Faculty?      @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  users          ProjectUser[]
  activities     Activity[]
  executiveDirective String?   @db.Text @map("executive_directive")
  directiveUpdatedAt DateTime? @map("directive_updated_at")
  directiveIssuerName String?  @map("directive_issuer_name")
  directiveIssuerRole String?  @map("directive_issuer_role")

  deanDirective          String?   @db.Text @map("dean_directive")
  deanDirectiveUpdatedAt DateTime? @map("dean_directive_updated_at")
  deanDirectiveIssuerName String?  @map("dean_directive_issuer_name")

  presidentDirective          String?   @db.Text @map("president_directive")
  presidentDirectiveUpdatedAt DateTime? @map("president_directive_updated_at")
  presidentDirectiveIssuerName String?  @map("president_directive_issuer_name")

  isLocked       Boolean       @default(true) @map("is_locked")

  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@map("projects")
}

model ProjectUser {
  projectId Int      @map("project_id")
  userId    Int      @map("user_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([projectId, userId])
  @@map("project_users")
}

model Activity {
  id             Int             @id @default(autoincrement())
  projectId      Int             @map("project_id")
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  description    String?         @db.Text
  activityDate   DateTime        @map("activity_date")
  budget         Decimal         @db.Decimal(12, 2)
  isLocked       Boolean         @default(true) @map("is_locked")
  actualBudget   Decimal?        @db.Decimal(12, 2) @map("actual_budget")
  success        Boolean         @default(false)
  completedCount Int             @default(0) @map("completed_count")
  remark         String?         @db.Text
  images         ActivityImage[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("activities")
}

model ActivityImage {
  id         Int      @id @default(autoincrement())
  activityId Int      @map("activity_id")
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  filePath   String   @db.Text @map("file_path")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("activity_images")
}

enum IssueStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model IssueReport {
  id          Int           @id @default(autoincrement())
  title       String
  description String        @db.Text
  category    String?
  priority    IssuePriority @default(MEDIUM)
  status      IssueStatus   @default(PENDING)
  adminNote   String?       @db.Text @map("admin_note")
  userId      Int           @map("user_id")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("issue_reports")
}
